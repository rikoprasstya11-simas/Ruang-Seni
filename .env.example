# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GAS_WEBAPP_URL: URL Web App Google Apps Script untuk halaman depan & unggah karya siswa (Vercel)
VITE_GAS_WEBAPP_URL=""

# SENI_RUANG_GAS_URL: Opsional alias server-side untuk endpoint Google Apps Script Web App
SENI_RUANG_GAS_URL=""
